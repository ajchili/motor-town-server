# Steam account that owns Motor Town (anonymous login can't download the server).
# Username only: steamcmd asks for the password and Steam Guard code itself on
# `docker compose run --rm motortown login`, then caches a login token.
STEAM_USER=

# The dedicated server app. Its default branch only holds a placeholder; the
# real server is on the "beta" branch, unlocked with the developer's code.
STEAM_APP_ID=2223650
# Base game app ID, written to steam_appid.txt next to the server exe. Without
# it the server hangs at "Creating Session..".
STEAM_GAME_APP_ID=1369670
STEAM_BETA=beta
STEAM_BETA_PASSWORD=motortowndedi

# Leave empty to auto-detect MotorTownServer-Win64-Shipping.exe
SERVER_EXE=
# Leave empty for the server's own defaults: Jeju_World?listen? -server -log -useperfthreads
SERVER_ARGS=
